# ==============================================================================
# STOPCELL WEB — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie para 'web/.env' (ou '.env.production' para o build):
#   cp .env.example .env
#
# O Vite grava este valor no build: ele precisa estar definido ANTES de rodar
# `npm run build`. Sem ele, o site publicado tenta chamar http://localhost:3000.
# ==============================================================================

# Endereço público da API
VITE_API_URL=http://localhost:3000
