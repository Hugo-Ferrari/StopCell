# ==============================================================================
# STOPCELL API — VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie para 'api/.env':
#   cp .env.example .env
# ==============================================================================

# Banco de dados PostgreSQL (ex: Neon DB)
DATABASE_URL="postgresql://usuario:senha@host:5432/neondb?sslmode=verify-full"

# Chave secreta JWT para autenticação
JWT_SECRET="sua_chave_secreta_jwt"

# Porta do servidor (opcional, padrão 3000)
PORT=3000

# ------------------------------------------------------------------------------
# Recuperação de senha por e-mail (Gmail SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=seuemail@gmail.com

# Senha de app do Gmail (16 letras): https://myaccount.google.com/apppasswords
MAIL_PASS=sua_senha_de_app_16_letras

# Nome de exibição do remetente
MAIL_FROM="StopCell <seuemail@gmail.com>"
