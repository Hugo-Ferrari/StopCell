# ==============================================================================
# STOPCELL — MODELO DE VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para 'api/.env' e preencha os valores antes de rodar o projeto:
#   cp .env.example api/.env
#
# NUNCA comite arquivos '.env' reais no Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BANCO DE DADOS (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=verify-full
DATABASE_URL="postgresql://usuario:senha@seu-host-neon.tech/neondb?sslmode=verify-full"

# ------------------------------------------------------------------------------
# 2. AUTENTICAÇÃO & SEGURANÇA (JWT)
# ------------------------------------------------------------------------------
# Chave secreta usada para assinar e validar os tokens de login (escolha uma chave forte)
JWT_SECRET="sua_chave_secreta_jwt_super_segura"

# Porta onde a API NestJS vai rodar (padrão: 3000)
PORT=3000

# ------------------------------------------------------------------------------
# 3. ENVIO DE E-MAILS (Recuperação de Senha via Gmail SMTP)
# ------------------------------------------------------------------------------
# Servidor SMTP do Gmail
MAIL_HOST=smtp.gmail.com

# Porta SMTP:
#   587 -> STARTTLS (Recomendada)
#   465 -> SSL direto
MAIL_PORT=587

# E-mail do remetente (sua conta Google)
MAIL_USER=seuemail@gmail.com

# Senha de Aplicativo de 16 letras gerada na sua Conta Google.
# COMO GERAR:
#   1. Ative a verificação em 2 etapas: https://myaccount.google.com/security
#   2. Acesse: https://myaccount.google.com/apppasswords
#   3. Crie uma senha com o nome "StopCell" (gera 16 letras sem espaços)
#   4. Cole as 16 letras abaixo:
MAIL_PASS=sua_senha_de_app_16_letras

# Nome e endereço exibidos no remetente para o usuário final
MAIL_FROM="StopCell <seuemail@gmail.com>"
